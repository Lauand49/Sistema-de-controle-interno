# Banco DESCARTÁVEL para os testes de integração (npm run test:int). Sem segredos reais aqui.
# O NOME DO BANCO DEVE TERMINAR EM "_test": os testes apagam dados e recusam qualquer outro nome.
# Nunca aponte para o banco de desenvolvimento (scitec_dev) nem para produção.
#
#   createdb scitec_test
#   cp .env.test.example .env.test   # e ajuste usuário/senha/porta
#   npm run test:int
TEST_DATABASE_URL="postgresql://USUARIO:SENHA@localhost:5432/scitec_test?schema=public"
