# ── Banco (Postgres) ──────────────────────────────────────────────
# Local (Homebrew/Docker) ou Neon (produção: use a connection string com ?sslmode=require)
DATABASE_URL="postgresql://USUARIO:SENHA@localhost:5432/scitec_dev?schema=public"

# ── Auth.js ───────────────────────────────────────────────────────
# Gere com: npx auth secret   (ou: openssl rand -base64 32)
AUTH_SECRET=""
# OAuth Client do Google Cloud (tipo "Aplicativo da Web").
# Redirect URI autorizado: <URL do site>/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Só entram e-mails deste domínio (verificado no servidor, além do parâmetro hd do Google)
ALLOWED_EMAIL_DOMAIN="scitecjr.com"
# Entram direto como Presidente/ATIVO (separados por vírgula)
ADMIN_EMAILS="joao.vaz@scitecjr.com"

# Login de desenvolvimento sem Google: só funciona com NODE_ENV=development (npm run dev).
# Nunca habilite em produção.
DEV_LOGIN="false"

# ── Minerador de leads (IA opcional) ──────────────────────────────
# Chave do Google AI Studio (Gemini). Vazia = minerações rodam sem IA.
# Lida só no servidor (lib/leads/deps.ts) e enviada no cabeçalho x-goog-api-key.
GEMINI_API_KEY=""
# Máximo de chamadas ao Gemini por mês (inteiro positivo; padrão 1000).
GEMINI_MONTHLY_LIMIT=""
# Modelo usado (padrão gemini-2.0-flash).
GEMINI_MODEL=""

# ── Minerador de leads (Google Places e PageSpeed, opcionais) ─────
# Chaves lidas só no servidor (lib/leads/deps.ts) e enviadas no cabeçalho X-Goog-Api-Key
# (nunca na URL nem no navegador).
# Chave da Places API (New). Vazia = minerações usam só o OpenStreetMap.
GOOGLE_PLACES_API_KEY=""
# Máximo de chamadas ao Google Places por mês (inteiro positivo; padrão 1000).
PLACES_MONTHLY_LIMIT=""
# Chave da PageSpeed Insights API. Vazia = análises rodam sem chave, com a cota reduzida do Google.
PAGESPEED_API_KEY=""
# Máximo de chamadas ao PageSpeed por mês (inteiro positivo; padrão 5000).
PAGESPEED_MONTHLY_LIMIT=""
