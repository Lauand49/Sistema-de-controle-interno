# ── Banco (Postgres) ──────────────────────────────────────────────
# Local (Homebrew/Docker) ou Neon (produção: use a connection string com ?sslmode=require)
DATABASE_URL="postgresql://USUARIO:SENHA@localhost:5432/scitec_dev?schema=public"

# ── Auth.js ───────────────────────────────────────────────────────
# Gere com: npx auth secret   (ou: openssl rand -base64 32)
AUTH_SECRET=""
# OAuth Client do Google Cloud (tipo "Aplicativo da Web").
# Redirect URI autorizado: <URL do site>/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Só entram e-mails deste domínio (verificado no servidor, além do parâmetro hd do Google)
ALLOWED_EMAIL_DOMAIN="scitecjr.com"
# Entram direto como Presidente/ATIVO (separados por vírgula)
ADMIN_EMAILS="joao.vaz@scitecjr.com"

# Login de desenvolvimento sem Google: só funciona com NODE_ENV=development (npm run dev).
# Nunca habilite em produção.
DEV_LOGIN="false"

# ── Etapas futuras (minerador de leads) ───────────────────────────
