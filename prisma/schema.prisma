// Prisma Schema — Sistema Interno SciTec jr. (Postgres)
//
// ATENÇÃO: a migração inicial cria índices únicos PARCIAIS e CHECKs que o Prisma não
// representa no schema (um gerente por departamento/setor; Presidente/Vice sem departamento).
// Ao gerar novas migrações com `prisma migrate dev`, remova do SQL gerado qualquer
// `DROP INDEX` desses índices:
//   - "User_one_manager_per_department"
//   - "SectorMember_one_manager_per_sector"
//   - "MiningRun_one_active_per_author_params" (migração lead_miner: uma mineração
//     PENDENTE/EM_ANDAMENTO por autor e conjunto de parâmetros)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────── Hierarquia ───────────────────────────────

enum GlobalRole {
  PRESIDENTE
  VICE_PRESIDENTE
}

enum UserStatus {
  PENDENTE
  ATIVO
  INATIVO
}

enum DepartmentRole {
  GERENTE
  ASSESSOR
}

enum UnitType {
  DEPARTAMENTO
  SETOR
}

enum SectorRole {
  GERENTE
  MEMBRO
}

model User {
  id             String          @id @default(uuid())
  name           String
  email          String          @unique
  avatar         String?
  cargo          String? // Título livre exibido (opcional)
  globalRole     GlobalRole? // Presidente / Vice (sem departamento)
  status         UserStatus      @default(PENDENTE)
  departmentId   String?
  department     Unit?           @relation("DepartmentMembers", fields: [departmentId], references: [id], onDelete: Restrict)
  departmentRole DepartmentRole?
  lastLoginAt    DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  sectorMemberships SectorMember[]
  auditActions      AuditLog[]         @relation("AuditActor")
  auditTargets      AuditLog[]         @relation("AuditTarget")
  assignedCards     Card[]
  activities        CardActivity[]
  assignedLeads     ProspectLead[]
  assignedTasks     Task[]
  requestsCreated   CrossDeptRequest[] @relation("RequesterRelation")
  requestsHandled   CrossDeptRequest[] @relation("HandlerRelation")
  miningRuns        MiningRun[]
  assignedCompanies Company[]
  approachMessages  ApproachMessage[]

  @@index([departmentId])
  @@index([status])
}

// Departamento (NEGOCIOS, ADMJURFIN, GENTE, MIDIAS) ou Setor (TEC_SOFTWARE, ...)
model Unit {
  id   String   @id @default(uuid())
  code String   @unique
  name String
  type UnitType

  departmentMembers User[]         @relation("DepartmentMembers")
  sectorMembers     SectorMember[]
  pipes             Pipe[]
  tasks             Task[]
  auditLogs         AuditLog[]
}

model SectorMember {
  id        String     @id @default(uuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  unitId    String
  unit      Unit       @relation(fields: [unitId], references: [id], onDelete: Cascade)
  role      SectorRole @default(MEMBRO)
  createdAt DateTime   @default(now())

  @@unique([userId, unitId])
  @@index([unitId])
}

model AuditLog {
  id           String   @id @default(uuid())
  actorId      String?
  actor        User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  action       String // USER_APPROVED, DEPARTMENT_ROLE_CHANGED, SECTOR_MEMBER_ADDED, ...
  targetUserId String?
  targetUser   User?    @relation("AuditTarget", fields: [targetUserId], references: [id], onDelete: SetNull)
  unitId       String?
  unit         Unit?    @relation(fields: [unitId], references: [id], onDelete: SetNull)
  before       Json?
  after        Json?
  createdAt    DateTime @default(now())

  @@index([targetUserId])
  @@index([unitId])
  @@index([createdAt])
}

// ─────────────────────────────── Funis ───────────────────────────────

model Pipe {
  id          String   @id @default(uuid())
  name        String
  description String?
  unitId      String
  unit        Unit     @relation(fields: [unitId], references: [id], onDelete: Restrict)
  icon        String? // Nome do ícone lucide
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  phases Phase[]

  @@index([unitId])
}

model Phase {
  id        String   @id @default(uuid())
  name      String
  order     Int
  pipeId    String
  pipe      Pipe     @relation(fields: [pipeId], references: [id], onDelete: Cascade)
  isFinal   Boolean  @default(false)
  color     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fields Field[]
  cards  Card[]

  @@index([pipeId])
}

model Field {
  id        String   @id @default(uuid())
  name      String
  label     String
  type      String // TEXT, NUMBER, CURRENCY, DATE, SELECT, TEXTAREA
  options   String? // Array JSON de opções (SELECT)
  required  Boolean  @default(false)
  order     Int      @default(0)
  phaseId   String
  phase     Phase    @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cardValues CardFieldValue[]

  @@index([phaseId])
}

model Card {
  id          String   @id @default(uuid())
  title       String
  description String?
  order       Int      @default(0)
  phaseId     String
  phase       Phase    @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  assigneeId  String?
  assignee    User?    @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  values     CardFieldValue[]
  activities CardActivity[]

  @@index([phaseId])
  @@index([assigneeId])
}

model CardFieldValue {
  id        String   @id @default(uuid())
  cardId    String
  card      Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  fieldId   String
  field     Field    @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  value     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cardId, fieldId])
  @@index([cardId])
  @@index([fieldId])
}

model CardActivity {
  id          String   @id @default(uuid())
  cardId      String
  card        Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  type        String // PHASE_CHANGE, CARD_CREATED, FIELD_UPDATED, COMMENT
  description String
  metadata    String? // Payload JSON
  createdAt   DateTime @default(now())

  @@index([cardId])
  @@index([userId])
}

// ─────────────────────────────── Ferramentas ───────────────────────────────

model ProspectLead {
  id           String   @id @default(uuid())
  companyName  String
  contactName  String?
  contactInfo  String? // Telefone, e-mail ou link
  actionPlan   String // O que deve ser feito com esse lead
  notes        String?
  segment      String?
  status       String   @default("PENDING") // RAW, PENDING, IN_PROGRESS, CONVERTED_TO_PIPE, DISCARDED
  batchId      String?
  pipeCardId   String?
  assignedTo   String?
  assignedUser User?    @relation(fields: [assignedTo], references: [id], onDelete: SetNull)
  companyId    String?  @unique // Empresa minerada que originou o lead (Etapa 1)
  company      Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status])
  @@index([assignedTo])
  @@index([createdAt])
}

// ─────────────────────────────── Minerador de Leads ───────────────────────────────

enum MiningSource {
  OSM
  GOOGLE
  MISTA
}

enum MiningStatus {
  PENDENTE
  EM_ANDAMENTO
  CONCLUIDA
  ERRO
}

enum CompanyCategory {
  CRIAR_SITE
  OTIMIZACAO_SEGURANCA
  ANALISE_DADOS_BI
}

enum LeadPriority {
  ALTA
  MEDIA
  BAIXA
}

// Etapa 3 (lead-miner-enrichment)
enum CnpjOrigin {
  SITE
  MANUAL
}

enum ApproachChannel {
  WHATSAPP
  EMAIL
}

enum ApproachOrigin {
  IA
  MODELO
}

model Company {
  id              String           @id @default(uuid())
  googlePlaceId   String?          @unique // Etapa 3
  osmId           String?          @unique // "node/123"
  cnpj            String?          @unique // Etapa 3
  nome            String
  nomeNormalizado String
  nicho           String // id do nicho (lib/leads/config.ts)
  endereco        String?
  bairro          String?
  cidade          String?
  uf              String?
  telefone        String?
  website         String?
  latitude        Float?
  longitude       Float?
  marcaRede       String?
  fonte           MiningSource     @default(OSM)
  // snapshot da análise mais recente
  categoria       CompanyCategory?
  scoreFinal      Int?
  prioridade      LeadPriority?
  hasSite         Boolean?
  isHttps         Boolean?
  lastAnalyzedAt  DateTime?
  assignedTo      String?
  assignedUser    User?            @relation(fields: [assignedTo], references: [id], onDelete: SetNull)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  // ── Etapa 3 (lead-miner-enrichment) ──
  // nome: nome próprio (OSM/manual); '' para Empresa só do Google
  nomeExibicao        String      @default("") // Nome_Exibicao para ordenação; mantido junto do cache/Dados_CNPJ
  instagramOsm        String? // tag contact:instagram normalizada
  whatsappOsm         String? // tag contact:whatsapp normalizada
  cnpjOrigem          CnpjOrigin?
  cnpjCandidatos      Json        @default("[]") // CnpjCandidate[]
  cnpjStatus          String? // "CNPJ não encontrado na Receita" | "Consulta à Receita indisponível" | "CNPJ do site é de outra UF…"
  cnpjDadosCnpj       String? // CNPJ a que os Dados_CNPJ se referem
  cnpjConsultadoEm    DateTime?
  cnpjRazaoSocial     String?
  cnpjNomeFantasia    String?
  situacaoCadastral   String? // snapshot (filtro e alerta)
  cnpjSituacaoData    String?
  cnpjCnaeCodigo      String?
  cnpjCnaeDescricao   String?
  cnpjPorte           String?
  cnpjNatureza        String?
  cnpjMei             Boolean?
  cnpjInicioAtividade String?
  cnpjMunicipio       String?
  cnpjUf              String?
  temInstagram        Boolean? // snapshot
  temWhatsapp         Boolean? // snapshot
  desempenhoRuim      Boolean? // snapshot (filtro do ranking)
  reanaliseAte        DateTime? // lease da Reanalise

  analyses         CompanyAnalysis[]
  runs             MiningRunCompany[]
  aliases          CompanyAlias[]
  prospectLead     ProspectLead?
  googleCache      GooglePlaceCache?
  approachMessages ApproachMessage[]

  @@index([scoreFinal(sort: Desc), nome])
  @@index([scoreFinal(sort: Desc), nomeExibicao])
  @@index([situacaoCadastral])
  @@index([nomeNormalizado])
  @@index([uf, cidade, bairro])
  @@index([nicho])
  @@index([assignedTo])
  @@index([lastAnalyzedAt])
}

/// Cache_Google: todo Conteudo_Google da Empresa, válido por 30 dias (Req. 6.1).
model GooglePlaceCache {
  companyId      String   @id
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  placeId        String
  nome           String
  endereco       String?
  bairro         String?
  cidade         String?
  uf             String?
  telefone       String?
  website        String?
  latitude       Float?
  longitude      Float?
  mapsUri        String?
  businessStatus String?
  tipos          Json     @default("[]")
  obtidoEm       DateTime
  expiraEm       DateTime

  @@index([expiraEm])
}

// Identificadores externos fundidos numa Empresa (ex.: osmId de um elemento que casou por
// nome + proximidade com uma Empresa que já tinha outro osmId). Consultados na deduplicação
// com a mesma prioridade do identificador da própria Empresa (Req. 9).
model CompanyAlias {
  id         String       @id @default(uuid())
  companyId  String
  company    Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  source     MiningSource
  externalId String
  createdAt  DateTime     @default(now())

  @@unique([source, externalId])
  @@index([companyId])
}

model CompanyAnalysis {
  id              String          @id @default(uuid())
  companyId       String
  company         Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  runId           String?
  run             MiningRun?      @relation(fields: [runId], references: [id], onDelete: SetNull)
  hasSite         Boolean
  online          Boolean
  statusCode      Int?
  isHttps         Boolean
  sslValid        Boolean
  sslProblem      String?
  responseTime    Int? // ms
  lento           Boolean         @default(false)
  motivoFalha     String?
  finalUrl        String?
  categoria       CompanyCategory
  motivos         Json // string[]
  scoreDigital    Int
  scoreIcp        Int
  scoreObjetivo   Int
  scoreIa         Int?
  scoreFinal      Int
  prioridade      LeadPriority
  iaAplicada      Boolean         @default(false)
  iaMotivo        String? // "IA desabilitada" | "sem resposta" | "resposta inválida"
  oportunidadeIa  String?
  justificativaIa String?
  detalhamento    Json // ScoreBreakdown
  pagespeed       Json? // Etapa 3
  tecnologias     Json? // Etapa 3
  versaoScore     Int             @default(2) // 1 = análises anteriores à Etapa 3 (Req. 13.1)
  sinais          Json? // SinaisDigitais
  pagespeedMotivo String? // PageSpeedAbsence quando pagespeed é null
  cnpjEncontrados Json? // string[] encontrados no HTML (diagnóstico; sem HTML)
  createdAt       DateTime        @default(now())

  runLink          MiningRunCompany?
  approachMessages ApproachMessage[]

  @@index([companyId, createdAt(sort: Desc)])
}

// Índice único parcial "MiningRun_one_active_per_author_params" criado via SQL na migração.
model MiningRun {
  id                      String       @id @default(uuid())
  bairro                  String
  cidade                  String
  uf                      String
  bairroNorm              String
  cidadeNorm              String
  nichos                  Json // string[]
  excluirRedes            Boolean      @default(false)
  iaEnabled               Boolean      @default(false)
  iaDisabledReason        String? // "SEM_CHAVE" quando iaEnabled foi forçado a false (Req. 7.9)
  paramsKey               String // buildRunParamsKey(bairro, cidade, uf, nichos) (Req. 18.7)
  fonte                   MiningSource @default(OSM)
  status                  MiningStatus @default(PENDENTE)
  total                   Int          @default(0)
  processados             Int          @default(0)
  area                    Json? // SearchArea obtida no Nominatim
  nichosProcessados       Json         @default("[]")
  nichosFalhos            Json         @default("[]") // string[] de ids (Req. 2.14–2.17)
  errorMessage            String?
  lockedUntil             DateTime? // lease da descoberta
  createdById             String
  createdBy               User         @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt
  finishedAt              DateTime?
  // ── Etapa 3 (lead-miner-enrichment) ── (fonte = Fonte_Efetiva)
  fonteSolicitada         MiningSource @default(OSM)
  pagespeedEnabled        Boolean      @default(false)
  pagespeedMotivo         String? // COTA_ESGOTADA quando forçado a false
  cnpjEnabled             Boolean      @default(false)
  googleMotivo            String? // SEM_CHAVE | COTA_ESGOTADA | ERRO
  googleNichosAfetados    Json         @default("[]")
  nichosGoogleProcessados Json         @default("[]")
  nichosGoogleFalhos      Json         @default("[]")
  googleCursor            Json? // { nicheId, page, pageToken }

  companies MiningRunCompany[]
  analyses  CompanyAnalysis[]

  @@index([createdAt(sort: Desc)])
  @@index([bairroNorm, cidadeNorm, uf, status])
  @@index([createdById, status])
  @@index([createdById, paramsKey])
}

model MiningRunCompany {
  id           String           @id @default(uuid())
  runId        String
  run          MiningRun        @relation(fields: [runId], references: [id], onDelete: Cascade)
  companyId    String
  company      Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  isNew        Boolean
  nicho        String // nicho da 1ª ocorrência nesta mineração
  claimToken   String?
  claimedAt    DateTime?
  processedAt  DateTime?
  failed       Boolean          @default(false)
  errorMessage String?
  analysisId   String?          @unique
  analysis     CompanyAnalysis? @relation(fields: [analysisId], references: [id], onDelete: SetNull)
  origem       MiningSource     @default(OSM) // fonte(s) que trouxeram a Empresa nesta Mineracao (Etapa 3)
  createdAt    DateTime         @default(now())

  @@unique([runId, companyId])
  @@index([runId, processedAt])
}

model ApiUsage {
  id       String @id @default(uuid())
  provider String // "gemini" | "places" | "pagespeed"
  month    String // "AAAA-MM"
  count    Int    @default(0)

  @@unique([provider, month])
}

// Mensagem_Abordagem gerada para uma Empresa (Etapa 3).
model ApproachMessage {
  id         String           @id @default(uuid())
  companyId  String
  company    Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  analysisId String?
  analysis   CompanyAnalysis? @relation(fields: [analysisId], references: [id], onDelete: SetNull)
  canal      ApproachChannel
  origem     ApproachOrigin
  fallback   String? // ApproachFallbackReason
  assunto    String?
  texto      String
  authorId   String
  author     User             @relation(fields: [authorId], references: [id], onDelete: Restrict)
  createdAt  DateTime         @default(now())

  @@index([companyId, createdAt(sort: Desc)])
}

// Tarefas pertencem a uma unidade (departamento ou setor). unitId nulo = tarefa geral.
model Task {
  id          String    @id @default(uuid())
  title       String
  description String?
  status      String    @default("TODO") // TODO, IN_PROGRESS, DONE, CANCELLED
  priority    String    @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  dueDate     DateTime?
  unitId      String?
  unit        Unit?     @relation(fields: [unitId], references: [id], onDelete: SetNull)
  assigneeId  String?
  assignee    User?     @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  leadId      String?
  cardId      String?
  completedAt DateTime? // Data_Conclusao: instante em que a tarefa passou para DONE; mantido pela API_Tarefas
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([assigneeId])
  @@index([status])
  @@index([unitId])
  @@index([unitId, status])
  @@index([completedAt])
}

// Solicitações entre departamentos (códigos de departamento)
model CrossDeptRequest {
  id           String    @id @default(uuid())
  title        String
  description  String
  fromDept     String    @default("NEGOCIOS") // NEGOCIOS, ADMJURFIN, GENTE, MIDIAS, GLOBAL
  toDept       String    @default("ADMJURFIN")
  status       String    @default("PENDING") // PENDING, APPROVED, REJECTED, IN_PROGRESS, COMPLETED
  priority     String    @default("MEDIUM")
  requesterId  String
  requester    User      @relation("RequesterRelation", fields: [requesterId], references: [id])
  handlerId    String?
  handler      User?     @relation("HandlerRelation", fields: [handlerId], references: [id])
  linkedCardId String?
  dueDate      DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([toDept, status])
  @@index([fromDept])
  @@index([handlerId])
}

model FinancialTransaction {
  id            String    @id @default(uuid())
  description   String
  amount        Float
  type          String // INFLOW ou OUTFLOW
  category      String
  status        String    @default("PENDING") // PENDING, PAID, CANCELLED
  invoiceUrl    String?
  relatedCardId String?
  dueDate       DateTime?
  paymentDate   DateTime?
  createdAt     DateTime  @default(now())
}
